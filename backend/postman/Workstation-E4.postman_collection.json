          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayUrl}}{{authLoginPath}}",
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"{{staffEmail}}\", \"password\": \"{{compradorPassword}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Auth responde 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "let jwt = pm.cookies.get('jwt');",
                  "if (!jwt) {",
                  "  const setCookie = pm.response.headers.all().filter(h => h.key.toLowerCase() === 'set-cookie').map(h => h.value).join(';');",
                  "  const m = setCookie.match(/(?:^|[;,\\s])jwt=([^;]+)/);",
                  "  if (m) jwt = m[1];",
                  "}",
                  "pm.test('cookie jwt del staff', () => pm.expect(jwt).to.be.a('string').and.not.empty);",
                  "if (jwt) pm.environment.set('staffJwt', jwt);",
                  "pm.cookies.jar().clear(pm.request.url, () => {});"
                ]
              }
            }
