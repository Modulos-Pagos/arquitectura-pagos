        {
          "id": "ac5fa1f2-83d4-5204-be60-48a33000debc",
          "name": "I3.6 RabbitMQ recibió pago.realizado (Entradas) y pago.completado (Promociones)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{rabbitApi}}/queues/{{rabbitVhost}}/{{colaPagos}}/get",
            "body": {
              "mode": "raw",
              "raw": "{\"count\": 200, \"ackmode\": \"ack_requeue_true\", \"encoding\": \"auto\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{rabbitUser}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{rabbitPass}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Lee los mensajes de la cola de verificación SIN consumirlos (ackmode ack_requeue_true).",
                  "// 404 = la cola aún no existe (Pagos todavía no publicó nada desde que arrancó): se trata como vacía.",
                  "const lista = pm.response.code === 404 ? [] : pm.response.json();",
                  "const mensajes = (Array.isArray(lista) ? lista : []).map(m => {",
                  "  let cuerpo = {};",
                  "  try { cuerpo = JSON.parse(m.payload); } catch (e) {}",
                  "  return { clave: m.routing_key, cuerpo };",
                  "});",
                  "const idPago = pm.environment.get('idPago');",
                  "const delPago = mensajes.filter(m => m.cuerpo.id_pago === idPago || (m.cuerpo.data && m.cuerpo.data.id_pago === idPago));",
                  "console.log('Mensajes en ' + pm.environment.get('colaPagos') + ': ' + mensajes.length + ' (del pago ' + idPago + ': ' + delPago.map(m => m.clave).join(', ') + ')');",
                  "",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const realizado = delPago.find(m => m.clave === 'pago.realizado');",
                  "pm.test('pago.realizado publicado en ticketu.events', () => pm.expect(realizado, 'mensaje pago.realizado').to.be.ok);",
                  "pm.test('pago.realizado trae reserva, usuario, estado y monto', () => {",
                  "  const c = realizado.cuerpo;",
                  "  pm.expect(c.id_reserva).to.eql(pm.environment.get('idReserva'));",
                  "  pm.expect(c.id_usuario).to.eql(pm.environment.get('idUsuario'));",
                  "  pm.expect(c.estado_pago).to.eql('APROBADO');",
                  "  pm.expect(c.monto).to.eql(Number(pm.environment.get('total')));",
                  "});",
                  "pm.test('pago.completado publicado para Promociones', () => pm.expect(delPago.some(m => m.clave === 'pago.completado')).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "id": "d0d1bb00-0410-5f48-9400-55eb403bb034",
