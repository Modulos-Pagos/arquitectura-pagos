# ---------------------------------------------------------------
# Microservicio de Pagos — variables de entorno
# Copiar a .env y completar. NUNCA subir .env a GitHub.
# ---------------------------------------------------------------

# 3004 = puerto de Pagos que propone la guía del Platform Team (el 3000 es del front común).
# En Docker el contenedor escucha en 3000 y se publica en el 3004 del host.
PORT=3004
NODE_ENV=development

# --- Base de datos (PostgreSQL local, Docker o Supabase) ---
# Local / Docker:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pagos_db
# Supabase: Project Settings > Database > Connection string (URI) y DATABASE_SSL=true
# DATABASE_URL=postgresql://postgres.xxxxx:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_SSL=false
# Solo para `npm test` (el nombre de la BD debe contener "test": se borra en cada corrida)
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/pagos_test

# --- Sesión (contrato «Auth ↔ Pagos» v1.3) ---
# La sesión llega en la cookie jwt y SIEMPRE se valida con Auth (GET /internal/validar-sesion, más abajo).
# Pagos no valida el JWT por su cuenta: no hay JWT_SECRET ni modo mock.
# Roles de Auth: usuario, organizador, staff. Los de esta lista consultan pagos de cualquier usuario y los
# anulan o reembolsan (contrato Auth v1.3, regla 7).
ROLES_PRIVILEGIADOS=staff

# --- Pasarela de pago ---
# mock   = pasarela simulada (desarrollo, tests y Postman; no llama a Stripe)
# stripe = Stripe real en modo test (usar llaves sk_test_...)
PASARELA=mock
STRIPE_SECRET_KEY=<tu_llave_secreta_de_stripe_modo_test>
# Se obtiene con: stripe listen --forward-to localhost:3004/api/pagos/webhooks/stripe
STRIPE_WEBHOOK_SECRET=<tu_secreto_de_webhook_de_stripe>
STRIPE_TIMEOUT_MS=1200
# Duración de la sesión de checkout (Stripe exige mínimo 30 minutos)
CHECKOUT_EXPIRACION_MIN=30
# Página de pago del módulo (url_checkout = FRONTEND_URL/?id_pago=...; Stripe Checkout también vuelve ahí).
#  - Front propio de Pagos (frontend/):         http://localhost:5173
#  - Front común de TicketU (FrontendTitec):   http://localhost:3000/pagos
FRONTEND_URL=http://localhost:5173
# Correo que aparece ya completado en el checkout de Stripe (vacío = el usuario lo escribe)
CHECKOUT_EMAIL_DEFECTO=

# --- Integración con Entradas/Inventario (servicio que invocamos) ---
# mock = no se invoca a Entradas (se confía en el body recibido)
# http = se invoca GET {ENTRADAS_BASE_URL}{ENTRADAS_RUTA_RESERVA} para validar la orden
# En Docker (docker-compose.yml) se usa http por defecto: Pagos valida cada reserva en entradas-service.
ENTRADAS_MODO=mock
# Fuera de Docker: el Gateway (http://localhost:8080). En Docker: http://entradas-service:3000 (nombre del .env del Gateway).
ENTRADAS_BASE_URL=http://localhost:8080
# Ruta del servicio de Entradas ({id_reserva} se reemplaza). Debe empezar por /api/entradas para pasar
# por el API Gateway (no reescribe el path). Confirmar con Entradas.
ENTRADAS_RUTA_RESERVA=/api/entradas/reservas/{id_reserva}
ENTRADAS_TIMEOUT_MS=500

# CORS: orígenes del front separados por coma. La sesión va en cookie, así que se responde con el origen
# explícito y Access-Control-Allow-Credentials: true (no se permite *).
# none = sin CORS aquí (todo pasa por el API Gateway, que lo resuelve con su variable CORS_ORIGINS).
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------
# Integración con la plataforma TicketU (Platform Team)
# ---------------------------------------------------------------
# Prefijo público con que el API Gateway enruta a Pagos. El Gateway NO reescribe el path,
# así que el servicio responde en /api/pagos/... (y sigue respondiendo en /api/v1/pagos/...).
PREFIJO_GATEWAY=/api/pagos

# --- Auth (contrato «Auth ↔ Pagos» v1.3) ---
# En cada petición protegida: GET {AUTH_BASE_URL}/internal/validar-sesion con el header Cookie tal como
# llegó y x-api-key: AUTH_INTERNAL_API_KEY. Solo valen sesiones emitidas por Auth.
# Si Auth no responde en AUTH_TIMEOUT_MS: 503 AUTH_NO_DISPONIBLE (no se cobra).
# URL INTERNA de Auth (endpoint de red interna, no pasa por el Gateway).
#  - En Docker: http://auth-service:10000 (puerto de Auth según su Dockerfile y su contrato general v1.1).
#    Nunca localhost entre contenedores.
#  - Fuera de Docker: el puerto local de Auth, o el Auth simulado (npm run auth:simulado, puerto 3001).
AUTH_BASE_URL=http://localhost:3001
# Clave de servicio interno que entrega Auth (INTERNAL_API_KEY). Obligatoria: sin ella el servicio no arranca.
# La real se pide al equipo Auth por privado y NO se sube a GitHub. Con el Auth simulado sirve cualquier valor.
# En el Docker integrado: la misma clave configurada en auth-service y entradas-service (una por ambiente).
AUTH_INTERNAL_API_KEY=clave-dev-local
AUTH_TIMEOUT_MS=1000

# --- Auth simulado (SOLO DESARROLLO: npm run auth:simulado) ---
# Imita el endpoint de Auth para probar sin el servicio real. No es parte de Pagos: Pagos lo llama por HTTP
# igual que al Auth real. Abrir http://localhost:3001/login para iniciar una sesión de prueba (cookie jwt).
AUTH_SIMULADO_PUERTO=3001
AUTH_SIMULADO_SECRETO=secreto-del-auth-simulado

# --- Broker de eventos (RabbitMQ compartido) ---
# mock     = los eventos pago.* solo se registran en el log
# rabbitmq = se publican en el exchange compartido
# En Docker (docker-compose.yml) se usa rabbitmq por defecto.
BROKER_MODO=mock
# RabbitMQ del Platform Team (repo FWizav/backendticketU, carpeta event-broker): usuario ticketu,
# contraseña ticketu_dev y vhost ticketu.
#  - Pagos fuera de Docker: amqp://ticketu:ticketu_dev@localhost:5672/ticketu
#  - Pagos en Docker:       amqp://ticketu:ticketu_dev@ticketu-rabbitmq:5672/ticketu  (nunca localhost)
BROKER_URL=amqp://ticketu:ticketu_dev@localhost:5672/ticketu
BROKER_EXCHANGE=ticketu.events
BROKER_TIPO_EXCHANGE=topic
# Routing keys: pago.realizado, pago.rechazado, pago.anulado, pago.reembolsado.
# Convención del Platform Team: <recurso>.<hecho-en-pasado> (pago.realizado). "_" daría pago_realizado.
BROKER_SEPARADOR=.
BROKER_TIMEOUT_MS=2000
# Evento para Promociones al aprobarse un pago (contrato Promociones ↔ Pagos v1.0):
# { id_pago, id_usuario, id_evento, nombre_codigo }. Dejar vacío para no publicarlo.
BROKER_CLAVE_PROMOCIONES=pago.completado
