# ---------------------------------------------------------------
# Microservicio de Pagos — variables de entorno
# Copiar a .env y completar. NUNCA subir .env a GitHub.
# ---------------------------------------------------------------

PORT=3000
NODE_ENV=development

# --- Base de datos (PostgreSQL local, Docker o Supabase) ---
# Local / Docker:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pagos_db
# Supabase: Project Settings > Database > Connection string (URI) y DATABASE_SSL=true
# DATABASE_URL=postgresql://postgres.xxxxx:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_SSL=false
# Solo para `npm test` (el nombre de la BD debe contener "test": se borra en cada corrida)
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/pagos_test

# --- Autenticación (JWT emitido por el módulo Auth) ---
# Debe ser el MISMO secreto que usa Auth para firmar (HS256). Acordarlo con el equipo Auth.
JWT_SECRET=cambiar-este-secreto-compartido-con-auth
# Roles que pueden consultar/reembolsar pagos de cualquier usuario (servicios internos y admin)
ROLES_PRIVILEGIADOS=ADMIN,SERVICIO

# --- Pasarela de pago ---
# mock   = pasarela simulada (desarrollo, tests y Postman; no llama a Stripe)
# stripe = Stripe real en modo test (usar llaves sk_test_...)
PASARELA=mock
STRIPE_SECRET_KEY=<tu_llave_secreta_de_stripe_modo_test>
# Se obtiene con: stripe listen --forward-to localhost:3000/api/v1/pagos/webhooks/stripe
STRIPE_WEBHOOK_SECRET=<tu_secreto_de_webhook_de_stripe>
STRIPE_TIMEOUT_MS=1200
# Duración de la sesión de checkout (Stripe exige mínimo 30 minutos)
CHECKOUT_EXPIRACION_MIN=30
# A dónde vuelve el usuario después de pagar / cancelar (front del equipo)
FRONTEND_URL=http://localhost:5173
# Correo que aparece ya completado en el checkout de Stripe (vacío = el usuario lo escribe)
CHECKOUT_EMAIL_DEFECTO=

# --- Integración con Entradas/Inventario (servicio que invocamos) ---
# mock = no se invoca a Entradas (se confía en el body recibido)
# http = se invoca GET {ENTRADAS_BASE_URL}/api/v1/entradas/reservas/{id_reserva} para validar la orden
ENTRADAS_MODO=mock
ENTRADAS_BASE_URL=http://localhost:3003
ENTRADAS_TIMEOUT_MS=500

# CORS (origen del front). * = cualquiera
CORS_ORIGIN=*
