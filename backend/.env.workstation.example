# Configuración de Pagos para el WORKSTATION (TITEC 2026-2, Evaluación 3).
# Uso:  cp .env.workstation.example .env   y completar SOLO AUTH_INTERNAL_API_KEY.
# Todos los demás valores ya son los del workstation (nombres de la red plataforma-eventos-net).
# Ninguna dirección apunta a localhost: entre contenedores se usan los nombres de servicio.

# --- Lo único que hay que completar (no se sube a GitHub) ---
# La misma INTERNAL_API_KEY que usa Auth en el workstation (la entrega el equipo de Auth).
AUTH_INTERNAL_API_KEY=<INTERNAL_API_KEY de Auth en workstation>

# Dirección del front común en el navegador del workstation (a dónde vuelve el comprador después de pagar).
FRONTEND_URL=http://localhost:3000/pagos

# --- I1. Auth (autenticación) ---
AUTH_URL_DOCKER=http://auth-service:10000
AUTH_TIMEOUT_MS=1000

# --- I2. Entradas a través del API Gateway ---
API_GATEWAY_URL_DOCKER=http://ticketu-api-gateway:8080
ENTRADAS_MODO_DOCKER=http
ENTRADAS_RUTA_RESERVA=/api/entradas/reservas/{id_reserva}
ENTRADAS_TIMEOUT_MS_DOCKER=1500

# --- I3. Broker (RabbitMQ del Platform Team) ---
BROKER_MODO_DOCKER=rabbitmq
BROKER_URL_DOCKER=amqp://ticketu:ticketu_dev@ticketu-rabbitmq:5672/ticketu
EVENT_EXCHANGE=ticketu.events
# Cola durable propia enlazada a pago.* para ver cada mensaje en la consola de RabbitMQ.
BROKER_COLA_VERIFICACION=pagos.eventos
BROKER_CLAVE_PROMOCIONES=pago.completado

# --- Pasarela de pago ---
# mock: no necesita llaves. Para Stripe en modo prueba: PASARELA=stripe y las llaves sk_test/whsec por privado.
PASARELA=mock
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# --- Trazas y puerto ---
LOG_INTEGRACIONES=true
PAGOS_PUERTO_HOST=3004
