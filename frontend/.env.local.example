# Copiar como .env.local y completar (nunca subir .env.local a GitHub)

# Llave PUBLICABLE de Stripe (Dashboard > Desarrolladores > Claves de API > Clave publicable, pk_test_...)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<tu_llave_publicable_de_stripe_modo_test>

# API Gateway del Platform Team (mismo nombre de variable que el front común de TicketU).
# El front llama a ${NEXT_PUBLIC_GATEWAY_URL}/api/pagos/...
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080

# (Opcional) Solo para probar sin Gateway, apuntando directo a nuestro backend.
# Déjalo vacío para usar el Gateway. Ejemplo: http://localhost:3004/api/pagos
NEXT_PUBLIC_PAGOS_API_URL=

# Sesión (contrato Auth ↔ Pagos v1.3): la pone Auth en la cookie jwt (HttpOnly) al iniciar sesión.
# El front no lee ni maneja tokens: si Pagos responde 401, redirige a esta página de login.
#  - Con la plataforma: el login de Auth/portal (vacío = {NEXT_PUBLIC_PORTAL_URL}/login).
#  - En desarrollo con el Auth simulado del backend (npm run auth:simulado): http://localhost:3001/login
NEXT_PUBLIC_LOGIN_URL=http://localhost:3001/login

# (Opcional) URL del portal común de TicketU para los enlaces del menú del header.
# Si se deja vacío, los enlaces apuntan a "#".
NEXT_PUBLIC_PORTAL_URL=
