# Copiar como .env.local y completar

# Llave PUBLICABLE de Stripe (Dashboard > Desarrolladores > Claves de API > Clave publicable, pk_test_...)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# URL del microservicio de Pagos (backend)
NEXT_PUBLIC_PAGOS_API_URL=http://localhost:3000/api/v1/pagos

# Token JWT del comprador (en el backend: npm run token). Mientras Auth no esté integrado.
NEXT_PUBLIC_PAGOS_TOKEN=eyJ...
